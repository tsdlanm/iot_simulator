# Copy to server/.env (the server reads real environment variables; use `node --env-file=.env` or your shell).
PORT=8080
DATABASE_URL=postgres://iot:iot@localhost:5432/iot_designer

# Compile service (needs gcc-avr, avr-libc, binutils-avr, arduino-core-avr)
# COMPILE_AVR_DIR=/usr/share/arduino/hardware/arduino/avr
# COMPILE_CACHE_DIR=/var/cache/iot-designer-compile
# COMPILE_TIMEOUT_MS=20000
# COMPILE_CONCURRENCY=2
# COMPILE_RATE_LIMIT=30
# TRUST_PROXY=false
